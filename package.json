{
  "name": "free2free-workers",
  "version": "1.0.0",
  "description": "Free2Free API on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "typecheck:ci": "wrangler types --check && tsc --noEmit",
    "dev": "npm run typecheck && wrangler dev",
    "test": "npm run typecheck && vitest",
    "test:unit": "npm run typecheck && vitest --run test/unit",
    "test:integration": "npm run typecheck && vitest --run test/integration",
    "test:e2e": "npm run typecheck && vitest --run test/e2e",
    "test:coverage": "npm run typecheck && vitest --coverage",
    "db:reset": "tsx scripts/clean-database.ts local",
    "db:reset:remote": "tsx scripts/clean-database.ts remote",
    "cleanup:oauth:local": "node scripts/cleanup-oauth.js local",
    "cleanup:oauth:staging": "node scripts/cleanup-oauth.js staging",
    "cleanup:oauth:prod": "node scripts/cleanup-oauth.js production",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "e2e": "node scripts/run-e2e.js",
    "e2e:headed": "node scripts/run-e2e.js --headed",
    "e2e:debug": "node scripts/run-e2e.js --debug",
    "e2e:ui": "npm run test:ui --prefix frontend/e2e",
    "e2e:report": "npm run test:report --prefix frontend/e2e",
    "e2e:install": "npm run test:install --prefix frontend/e2e",
    "deploy": "npm run typecheck && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.11.4",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.0",
    "@types/node": "^25.0.8",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.7.4",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.59.2"
  }
}
